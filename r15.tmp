f.onsubmit=e=>{e.preventDefault();const msg=(ti.value||"").trim();if(!msg)return showToast("Write a comment before posting.");if(!rt)return showToast("Choose a star rating before posting.");if((msg.match(/\S+/g)||[]).length>L)return showToast("Comments must be 100 words or fewer.");if(!window.Comments.create({productId:p.id,userId:u?u.id:null,authorName:(ni.value||"Guest").trim()||"Guest",authorEmail:(ei.value||"").trim(),rating:rt,message:msg}))return showToast("Could not save your comment right now.");showToast("Comment posted");render(p)};
