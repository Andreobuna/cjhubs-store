if(l)l.innerHTML=c.length?c.map(x=>`<div class="comment-item"><div class="comment-avatar" aria-hidden="true">${((x.authorName||"G").trim().charAt(0)||"G").toUpperCase()}</div><div class="comment-body"><div class="comment-top"><strong>${esc(x.authorName||"Guest")}</strong><span>${new Date(x.createdAt).toLocaleDateString(undefined,{month:"short",day:"numeric",year:"numeric"})}</span></div><div class="comment-rating">${stars(x.rating)}</div><p>${esc(x.message)}</p></div></div>`).join(""):`<div class="comment-empty">Be the first to share feedback on this product.</div>`;
