const all=()=>{try{return(JSON.parse(localStorage.getItem(K)||"[]")||[]).map(x=>x&&typeof x==="object"?{id:x.id||"c"+Date.now()+Math.random().toString(36).slice(2,8),productId:x.productId||"",userId:x.userId||null,authorName:(x.authorName||"Guest").trim()||"Guest",authorEmail:(x.authorEmail||"").trim(),rating:Math.max(1,Math.min(5,Math.round(Number(x.rating)||0))),message:(x.message||"").trim(),createdAt:x.createdAt||Date.now()}:null).filter(x=>x&&x.productId&&x.message)}catch{return[]}};
