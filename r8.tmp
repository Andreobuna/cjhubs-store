const inject=()=>{if(document.getElementById(S))return;const s=document.createElement("style");s.id=S;s.textContent=".rating-picker{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 14px}.rating-btn{width:40px;height:40px;border:1px solid var(--gray-200);border-radius:12px;background:#fff;cursor:pointer;font-size:18px}.rating-btn.selected{background:linear-gradient(135deg,var(--gold-light),var(--gold-dark));color:var(--navy)}.comment-rating{letter-spacing:2px;color:var(--gold-dark);margin:0 0 8px}.comment-count small{display:block;font-size:12px;color:rgba(255,255,255,.82)}";document.head.appendChild(s)};
